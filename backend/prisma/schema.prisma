generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  LIBRARIAN
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  passwordHash String
  role      Role     @default(READER)
  loans     Loan[]
  reserves  Reservation[]
  createdAt DateTime @default(now())
}

model Book {
  id          Int            @id @default(autoincrement())
  title       String
  author      String
  isbn        String?        @unique
  genre       String?
  copies      BookCopy[]
  reserves    Reservation[]
  createdAt   DateTime       @default(now())
}

model BookCopy {
  id        Int      @id @default(autoincrement())
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
  status    String   @default("available")
  location  String?
  loans     Loan[]
}

model Loan {
  id         Int       @id @default(autoincrement())
  user       User      @relation(fields: [userId], references: [id])
  userId     Int
  copy       BookCopy  @relation(fields: [copyId], references: [id])
  copyId     Int
  issuedAt   DateTime  @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  fineCents  Int       @default(0)
}

model Reservation {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
  status    String   @default("active")
  createdAt DateTime @default(now())
}
