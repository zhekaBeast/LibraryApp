generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  LIBRARIAN
  ADMIN
}

enum CopyStatus {
  AVAILABLE
  BORROWED
  DELETED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

model User {
  id        Int           @id @default(autoincrement())
  email     String        @unique
  name      String
  passwordHash String
  role      Role          @default(READER)
  createdAt DateTime      @default(now())
}

model Book {
  id          Int            @id @default(autoincrement())
  title       String
  author      String
  isbn        String?        @unique
  genre       String?
  createdAt   DateTime       @default(now())
}

model BookCopy {
  id        Int      @id @default(autoincrement())
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
  status    CopyStatus @default(AVAILABLE)
}

model Loan {
  id         Int       @id @default(autoincrement())
  user       User      @relation(fields: [userId], references: [id])
  userId     Int
  copy       BookCopy  @relation(fields: [copyId], references: [id])
  copyId     Int
  issuedAt   DateTime  @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  fineCents  Int       @default(0)
  status     LoanStatus @default(ACTIVE)
}

model Reservation {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
  status    String   @default("active")
  createdAt DateTime @default(now())
  expiresAt DateTime? 
  status    ReserveStatus @default(ACTIVE)
}

model Review {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
  rating    Int      
  comment   String?  
  createdAt DateTime @default(now())
  
  @@unique([userId, bookId]) 
}

model Notification {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  title     String   
  message   String  
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}